# The Node version in package.json's "engines" is a requirement, not a wish:
# pnpm refuses to install or run scripts on another major. Without this, an
# older Node installs happily and the difference only shows up as tests that
# fail here and pass in CI (seen with Node 20 against a repository that needs
# 22). Use the version in .nvmrc: nvm use, fnm use, or volta pin.
engine-strict=true

confirmModulesPurge=false
node-linker=hoisted
symlink=false
