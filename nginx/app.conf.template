# ============================================================================
# Nest Starter — Nginx site config (TEMPLATE)
# ============================================================================
# One domain: the API. Adapt as needed.
#
# Placeholders (replaced by bootstrap-nginx.sh via sed):
#   API_DOMAIN         e.g.  api.example.com
#   API_PORT           host port the NestJS container binds to (default 3000)
#
# After installing:
#   1. sudo ln -s /etc/nginx/sites-available/<app> /etc/nginx/sites-enabled/
#   2. sudo nginx -t                       # validate
#   3. sudo systemctl reload nginx
#   4. sudo certbot --nginx -d API_DOMAIN
#      ↑ certbot edits this file in place to add 443 server blocks + cert paths.
#
# Every directive lives INSIDE a server block. Files in sites-enabled/ are
# included into nginx's shared http{} context, so a directive written at the
# top level of this file applies to every site on the machine — and when a
# second site does the same (e.g. the React starter's config on the same VPS),
# nginx refuses to start: `"real_ip_header" directive is duplicate`.
# ============================================================================

# ─── Backend API ────────────────────────────────────────────────────────────
server {
	listen 80;
	listen [::]:80;
	server_name API_DOMAIN;
	server_tokens off;
	# No HSTS header here: helmet (src/main.ts) already sends one on every API
	# response, and a second copy from nginx is a malformed duplicate.

	access_log /var/log/nginx/app-api-access.log;
	error_log  /var/log/nginx/app-api-error.log;

	# ── Cloudflare real-IP handling ─────────────────────────────────────
	# When Cloudflare's orange-cloud proxy is enabled for a DNS record, requests
	# arrive FROM Cloudflare's edge IPs, not the actual user. Without the block
	# below, `$remote_addr` would show Cloudflare's IP — useless for audit logs,
	# rate limiting, and ban-by-IP features.
	#
	# Trusting Cloudflare's published ranges + reading CF-Connecting-IP rewrites
	# $remote_addr to the real client IP before any logging or proxying happens.
	# Safe to leave enabled even with grey-cloud (DNS-only) DNS — it's a no-op
	# until traffic actually comes from a trusted Cloudflare IP.
	#
	# To check for drift in Cloudflare's IP list:
	#   curl https://www.cloudflare.com/ips-v4
	#   curl https://www.cloudflare.com/ips-v6
	# Last refreshed: 2026-05-22.

	# Cloudflare IPv4 ranges
	set_real_ip_from 173.245.48.0/20;
	set_real_ip_from 103.21.244.0/22;
	set_real_ip_from 103.22.200.0/22;
	set_real_ip_from 103.31.4.0/22;
	set_real_ip_from 141.101.64.0/18;
	set_real_ip_from 108.162.192.0/18;
	set_real_ip_from 190.93.240.0/20;
	set_real_ip_from 188.114.96.0/20;
	set_real_ip_from 197.234.240.0/22;
	set_real_ip_from 198.41.128.0/17;
	set_real_ip_from 162.158.0.0/15;
	set_real_ip_from 104.16.0.0/13;
	set_real_ip_from 104.24.0.0/14;
	set_real_ip_from 172.64.0.0/13;
	set_real_ip_from 131.0.72.0/22;

	# Cloudflare IPv6 ranges
	set_real_ip_from 2400:cb00::/32;
	set_real_ip_from 2606:4700::/32;
	set_real_ip_from 2803:f800::/32;
	set_real_ip_from 2405:b500::/32;
	set_real_ip_from 2405:8100::/32;
	set_real_ip_from 2a06:98c0::/29;
	set_real_ip_from 2c0f:f248::/32;

	real_ip_header CF-Connecting-IP;
	real_ip_recursive on;

	# ── Limits ──────────────────────────────────────────────────────────
	# The largest body the API accepts is a 5 MB avatar (MAX_FILE_SIZE); the
	# extra 1 MB covers multipart framing. Raise both together.
	client_max_body_size 6M;
	# Above the app's REQUEST_TIMEOUT_MS (30s), so the app answers 408 with
	# its own error envelope before nginx gives up with a bare 504.
	proxy_read_timeout 60s;
	proxy_send_timeout 60s;

	# ── Proxy headers ───────────────────────────────────────────────────
	# $remote_addr is the REAL client IP, already rewritten above for
	# Cloudflare-originated requests. Downstream apps see the actual end-user.
	proxy_http_version 1.1;
	proxy_set_header Host              $host;
	proxy_set_header X-Real-IP         $remote_addr;
	# Set, not appended to: a client could otherwise send its own
	# X-Forwarded-For and pass for any address it likes (the app's logs and
	# rate-limits sign-ins by it).
	proxy_set_header X-Forwarded-For   $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host  $host;
	# An empty Connection header lets nginx reuse upstream connections. The
	# API has no WebSockets; if you add some, give that location
	# `proxy_set_header Upgrade $http_upgrade;` and `Connection "upgrade";`
	# rather than sending "upgrade" on every request, which disables keepalive.
	proxy_set_header Connection        "";

	# CORS handled by the NestJS app (don't double-handle here).

	# ── Operational endpoints: not for the public internet ──────────────
	#
	# Prometheus scrapes /api/v1/metrics from inside the Docker network and
	# never needs the public route; the app exempts it from auth and rate
	# limiting, so this block is its only protection. /admin/queues is a live
	# BullMQ dashboard that can inspect and manipulate jobs (it also has basic
	# auth).
	#
	# Case-insensitive regex locations (~*): Express matches routes without
	# regard to case, so a plain `location /admin/queues` let /Admin/Queues
	# through to the app. The metrics pattern covers the versioned route the
	# app actually serves, which the old `location /metrics` never matched.
	#
	# Replace the allow rules with your own admin/VPN ranges as needed.
	location ~* ^/(api/v[0-9]+/)?metrics(/|$) {
		allow 127.0.0.1;
		allow 172.16.0.0/12;   # Docker bridge networks
		allow 10.0.0.0/8;      # private VPC / VPN
		deny all;
		proxy_pass http://127.0.0.1:API_PORT;
	}

	location ~* ^/admin/queues(/|$) {
		allow 127.0.0.1;
		allow 172.16.0.0/12;
		allow 10.0.0.0/8;
		deny all;
		proxy_pass http://127.0.0.1:API_PORT;
	}

	location / {
		proxy_pass http://127.0.0.1:API_PORT;
	}
}
