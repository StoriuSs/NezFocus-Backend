model User {
  id String @id @default(uuid())

  // Profile / searchable fields (store when app needs search/profile views)
  // Uniqueness is enforced by a hand-written partial, case-insensitive
  // index (see migration 20260908000000_username_case_insensitive_unique).
  // Prisma cannot express `UNIQUE (lower(username)) WHERE deleted_at IS NULL`,
  // so @unique is deliberately absent here.
  username String?

  // The sign-in address, always confirmed: an account is only made once its
  // owner entered the code sent to it, or by a provider that verified it
  // (D-59, D-133). Stored lower-case; nullable only because the retention
  // sweep erases it from long-deleted accounts. Unique among live accounts,
  // case-insensitively — a hand-written partial index again (migration
  // 20260923000000_self_hosted_auth), so a deleted account's address can be
  // used afresh.
  email String?
  // Checked by @Roles(). Changed with `pnpm user:promote`, not by users.
  roles String[] @default(["user"])

  displayName String?
  avatarUrl   String?
  bio         String?

  // When the owner finished the "complete your account" step (D-61, D-128).
  // Empty: the account was just made (by a code or by Google) and cannot use
  // the app yet.
  completedAt     DateTime? @db.Timestamptz(6)
  // When the owner ticked "I agree to the Terms and the Privacy Policy" in
  // that step (REQ-AUTH-01). Empty for accounts completed before L7.
  termsAcceptedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  deletedBy String?

  // When the owner asked to delete the account (REQ-AUTH-09, D-141). It is
  // deleted 14 days later unless they sign in and restore it. Meanwhile the
  // account stays live (deletedAt empty), so its address and username stay
  // taken and every way of signing in still finds it.
  deletionRequestedAt DateTime? @db.Timestamptz(6)

  // Owned by the auth module (prisma/models/auth.prisma). Declared here only
  // because Prisma needs both sides of a relation; the users module never
  // reads or writes them.
  credential    Credential?
  sessions      Session[]
  oauthAccounts OAuthAccount[]

  // Made when the account is completed; until then every setting reads as
  // its default (SRS 7.1, D-131).
  settings UserSettings?

  // Owned by the servers module (prisma/models/servers.prisma); declared here
  // only because Prisma needs both sides of a relation.
  ownedServers   Server[] @relation("ServerOwner")
  memberships    Member[]
  createdInvites Invite[] @relation("InviteCreator")
  bans           Ban[]    @relation("BannedUser")
  bansGiven      Ban[]    @relation("BannedBy")

  // Owned by the messaging module (prisma/models/messaging.prisma); declared
  // here only because Prisma needs both sides of a relation.
  messages        Message[]        @relation("MessageAuthor")
  attachments     Attachment[]     @relation("AttachmentUploader")
  reactions       Reaction[]
  pinsGiven       Pin[]            @relation("PinnedBy")
  readStates      ReadState[]
  messageMentions MessageMention[]

  @@index([username])
  @@index([deletedAt])
  @@index([deletionRequestedAt])
}

/// What a person chose for themselves, the same in every browser (SRS 7.1,
/// D-131). Some switches only take effect in later milestones; they are
/// stored now so the settings pages are whole from the start.
model UserSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// An IANA zone name as the browser sent it, e.g. Asia/Ho_Chi_Minh
  /// (timezone.rules.ts).
  timezone          String
  /// When the zone was last changed in the settings: one change a day
  /// (REQ-AUTH-08). The choice made when completing the account does not count.
  timezoneChangedAt DateTime? @db.Timestamptz(6)
  /// vi | en. Also the language of emails nobody asked for (D-132).
  language          String
  /// light | dark | system (D-37).
  theme             String    @default("system")
  /// The sound when a study phase ends (REQ-STUDY-06).
  phaseSound        Boolean   @default(true)

  /// Browser notifications: the main switch, then one per kind (REQ-NOTIF-04).
  browserNotifications        Boolean @default(false)
  notifyMentions              Boolean @default(true)
  notifyDirectMessages        Boolean @default(true)
  notifyIncomingCalls         Boolean @default(true)
  notifyPhaseChanges          Boolean @default(true)
  /// "Not now" on the prompt to turn them on: it is not shown again (D-100).
  notificationPromptDismissed Boolean @default(false)

  /// Direct messages from people who share a server (REQ-SOCIAL-04).
  allowServerMemberMessages Boolean @default(true)
  /// "Show study activity" (D-79).
  showStudyActivity         Boolean @default(true)

  /// The status they chose (REQ-AUTH-07): online | do_not_disturb |
  /// invisible. Idle and offline are worked out from their open tabs and
  /// never stored (ARCHITECTURE 3.3).
  presence String @default("online")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
