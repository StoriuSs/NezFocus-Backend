        ]
      }
    },
    "/api/v1/auth/{provider}": {
      "get": {
        "operationId": "OAuthController_start_v1",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "example": "google",
              "type": "string"
            }
          },
          {
            "name": "redirect",
            "required": false,
            "in": "query",
            "description": "A path of the web app to return to. Default `/`.",
            "schema": {}
          }
        ],
        "responses": {
          "302": {
            "description": "To the provider"
          }
        },
        "summary": "Sign in with another provider. Redirects to the provider, and sets a\nshort-lived cookie that ties its return to this browser.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/{provider}/callback": {
      "get": {
        "operationId": "OAuthController_finish_v1",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "example": "google",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "To the web app"
          }
        },
        "summary": "Where the provider sends the browser back. Signs in and redirects to the\nweb app's `/auth/callback?redirect=<path>`; if it cannot, to\n`/auth/callback?error=cancelled|failed|email_unverified|account_deleted`.",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "testapp-backend-hexagonal-auth API",
    "description": "REST API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refresh_token": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "ApiResponseMetaDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "request_duration": {
            "type": "number",
            "description": "Milliseconds"
          }
        },
        "required": [
          "message",
          "timestamp"
        ]
      },
      "UserProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "Absent only for an account whose personal data has been erased.",
            "format": "email"
          },
          "username": {
            "type": "string",
            "maxLength": 32
          },
          "display_name": {
            "type": "string",
            "maxLength": 100
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bio": {
            "type": "string",
            "maxLength": 500
          },
          "has_set_username": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "avatar_url",
          "roles",
          "has_set_username"
        ]
      },
      "SetUsernameResponseDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "has_set_username": {
            "type": "boolean"
          }
        },
        "required": [
          "username",
          "has_set_username"
        ]
      },
      "SetUsernameRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "2-32 lowercase letters, digits, underscores or dots. Normalised to lower\ncase first, so `Alice` and `alice` are the same name. Permanent once set.",
            "minLength": 2,
            "maxLength": 32
          }
        },
        "required": [
          "username"
        ]
      },
      "UsernameAvailabilityResponseDto": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "available"
        ]
      },
      "UpdateProfileResponseDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true,
            "maxLength": 32
          },
          "display_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "has_set_username": {
            "type": "boolean"
          }
        },
        "required": [
          "username",
          "display_name",
          "avatar_url",
          "bio",
          "has_set_username"
        ]
      },
      "UpdateProfileRequestDto": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 100
          },
          "bio": {
            "type": "string",
            "description": "An empty string clears the bio.",
            "maxLength": 500
          }
        }
      },
      "UploadAvatarResponseDto": {
        "type": "object",
        "properties": {
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "width": {
            "type": "number",
            "minimum": 1
          },
          "height": {
            "type": "number",
            "minimum": 1
          },
          "uploaded_at": {
            "type": "string"
          }
        },
        "required": [
          "avatar_url",
          "uploaded_at"
        ]
      },
      "EmailCodeRequestDto": {
        "type": "object",
        "properties": {
          "language": {
            "enum": [
              "vi",
              "en"
            ],
            "type": "string",
            "default": "en",
            "description": "The language of the page, for the email this sends."
          },
          "email": {
            "type": "string",
            "description": "The sign-in address. Compared case-insensitively.",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "SignedInAccountDto": {
        "type": "object",
        "properties": {
          "created": {
            "type": "boolean",
            "description": "Made by this sign-in: the address had no account (D-59)."
          },
          "completed": {
            "type": "boolean",
            "description": "Done the \"complete your account\" step. False: open it before anything\nelse (D-61). The gate that refuses it everywhere else comes with that\nstep (D-128)."
          }
        },
        "required": [
          "created",
          "completed"
        ]
      },
      "EmailCodeSignInResponseDto": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/SignedInAccountDto"
          },
          "access_token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <access_token>`. Keep it in memory only."
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "number",
            "description": "Seconds until it expires. Refresh shortly before."
          }
        },
        "required": [
          "account",
          "access_token",
          "token_type",
          "expires_in"
        ]
      },
      "VerifyEmailCodeRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The six digits from the email.",
            "pattern": "^\\d{6}$"
          },
          "email": {
            "type": "string",
            "description": "The sign-in address. Compared case-insensitively.",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "code",
          "email"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <access_token>`. Keep it in memory only."
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "number",
            "description": "Seconds until it expires. Refresh shortly before."
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "email": {
            "type": "string",
            "description": "The sign-in address. Compared case-insensitively.",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "password",
          "email"
        ]
      },
      "AuthOptionsResponseDto": {
        "type": "object",
        "properties": {
          "providers": {
            "description": "The other providers configured for sign-in, by id (`google`). Empty when\nnone are. Start one with `GET /auth/<id>`.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "providers"
        ]
      },
      "ForgotPasswordRequestDto": {
        "type": "object",
        "properties": {
          "language": {
            "enum": [
              "vi",
              "en"
            ],
            "type": "string",
            "default": "en",
            "description": "The language of the page, for the email this sends."
          },
          "email": {
            "type": "string",
            "description": "The sign-in address. Compared case-insensitively.",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordRequestDto": {
        "type": "object",
        "properties": {
          "language": {
            "enum": [
              "vi",
              "en"
            ],
            "type": "string",
            "default": "en",
            "description": "The language of the page, for the email this sends."
          },
          "password": {
            "type": "string",
            "description": "The new password.",
            "minLength": 1,
            "maxLength": 1024
          },
          "code": {
            "type": "string",
            "description": "The six digits from the email.",
            "pattern": "^\\d{6}$"
          },
          "email": {
            "type": "string",
            "description": "The sign-in address. Compared case-insensitively.",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "password",
          "code",
          "email"
        ]
      },
      "ChangePasswordRequestDto": {
        "type": "object",
        "properties": {
          "language": {
            "enum": [
              "vi",
              "en"
            ],
            "type": "string",
            "default": "en",
            "description": "The language of the page, for the email this sends."
          },
          "current_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "new_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "current_password",
          "new_password"
        ]
      },
      "SignInMethodsResponseDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "boolean",
            "description": "The account has a password: email-and-password sign-in works. False for one made with Google, until a password is set."
          },
          "providers": {
            "description": "Other providers linked to the account, by id (`google`).",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "password",
          "providers"
        ]
      },
      "DeleteAccountRequestDto": {
        "type": "object",
        "properties": {
          "language": {
            "enum": [
              "vi",
              "en"
            ],
            "type": "string",
            "default": "en",
            "description": "The language of the page, for the email this sends."
          },
          "password": {
            "type": "string",
            "description": "The account's password.",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
