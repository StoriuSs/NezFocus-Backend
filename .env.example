# ==============================================================================
# Environment Configuration Template
#
# Copy this file to .env.development or .env.production and fill in your values:
#
#   cp .env.example .env.development   # local development
#   cp .env.example .env.production    # production (VPS)
#
# Both .env.development and .env.production are gitignored.
# Only this file (.env.example) is committed to git.
# ==============================================================================

# Application
NODE_ENV=development
# The host port for the API. Development: 8888 (the web app's .env.example
# points there). In .env.production set PORT=3000: the host nginx proxies to
# 3000 unless bootstrap-nginx.sh was given --api-port, and anything else is a
# 502. (Inside the container the app always listens on 3000.)
PORT=8888
API_PREFIX=api
APP_NAME=YourAppName
BASE_URL=http://localhost:8888
# The web app's address; links in emails point there. Required in production.
FRONTEND_URL=http://localhost:3001
# Where people can ask for help, named in the emails where only a person can
# (an account deleted by someone else). Optional.
SUPPORT_EMAIL=
GRACEFUL_SHUTDOWN_TIMEOUT_MS=5000

# Database
# How the app and Prisma connect when they run on this machine (pnpm dev,
# migrations, the tests): localhost and DB_PORT. In Docker both compose files
# build it from DB_USERNAME, DB_PASSWORD and DB_NAME with the host db instead,
# so on a server this line is ignored. In production those three may only
# contain letters, digits and . _ ~ - (they go into the URL as they are).
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name?schema=public
# Only for `pnpm prisma:check`, not the app: an empty scratch database where
# the migrations are replayed, to compare them with the schema. Each run wipes
# whatever it holds.
# SHADOW_DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name_shadow
DB_PORT=5432
DB_NAME=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# Connection pool (defaults shown). Keep DB_POOL_MAX x app instances well
# under Postgres' max_connections.
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Cache (2-Layer: In-memory + Redis)
CACHE_TTL=3600
CACHE_LRU_SIZE=500

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Request timeout (in ms)
REQUEST_TIMEOUT_MS=30000

# CORS
CORS_ORIGINS=http://localhost:3001
# Must be true when the frontend is on another origin (it usually is): the
# refresh cookie is only sent with credentials. Required in production.
CORS_CREDENTIALS=true

# Authentication (docs/auth/README.md; how to get each value: docs/setup/)
# Signs access tokens and keys the stored hashes of emailed codes. At least 32
# characters; generate one: openssl rand -hex 32. Changing it invalidates every
# access token at once; sessions refresh and carry on.
JWT_SECRET=your_jwt_secret_replace_with_openssl_rand_hex_32
# Access-token lifetime, in seconds (60-3600). Short on purpose: a token cannot
# be recalled once issued, only the session behind it.
# JWT_ACCESS_TTL_SECONDS=900
# How long a sign-in lasts, in days, however often it is refreshed.
# AUTH_SESSION_TTL_DAYS=30
# The refresh cookie's SameSite. lax works when the site and the API share a
# registrable domain (app.example.com and api.example.com). On different
# domains use none, which also needs Secure (HTTPS).
# AUTH_COOKIE_SAMESITE=lax
# Unset: Secure in production, not in development (plain-http localhost).
# AUTH_COOKIE_SECURE=

# Sign-in with Google (docs/auth/google-sign-in.md; the keys: docs/setup/google-sign-in.md). Both
# set turns "Continue with Google" on; both empty leaves it off. Register
# <BASE_URL>/api/v1/auth/google/callback as the redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate Limiting: requests per THROTTLE_TTL seconds, per route. Signed-in
# requests count per user (THROTTLE_LIMIT), the rest per IP network
# (THROTTLE_ANONYMOUS_LIMIT), so a room sharing one IP is not one bucket.
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_ANONYMOUS_LIMIT=300

# Email (SMTP)
#
# Sign-up and password reset email a code, so production needs a real SMTP
# server: the app refuses to start there without EMAIL_HOST.
#
# Any SMTP provider works — Brevo, Postmark, SES, Mailgun. Nothing in the code
# is tied to one, so switching is a pure env change.
#
# EMAIL_SECURE=true means implicit TLS (port 465). Use false with port 587,
# which negotiates STARTTLS. Leave EMAIL_USER empty for a server that takes
# mail without a login (Mailpit below, or a relay on a private network).
#
# For local development, `pnpm test:services:up` starts Mailpit — a catcher
# on localhost:1025 that shows every message at http://localhost:8025, so
# nothing is ever delivered for real.
# 127.0.0.1, not localhost: the mailer picks one of localhost's addresses at
# random, and Mailpit listens on IPv4 only, so ::1 would be refused.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=YourAppName
EMAIL_FROM_ADDRESS=noreply@example.com

# File Upload
STORAGE_TYPE=local  # options: local, s3
UPLOAD_DEST=./uploads
# The storage layer's general ceiling, in bytes. Avatars have their own limit
# (8 MB, JPG / PNG / WEBP: src/modules/users/domain/avatar.rules.ts).
MAX_FILE_SIZE=5242880
# Image decoding limits (defaults shown): decoded pixels, and time per image.
# MAX_IMAGE_PIXELS=40000000
# IMAGE_PROCESSING_TIMEOUT_MS=15000
# Images processed at once per app instance, and how many may wait for a slot
# (each for up to IMAGE_PROCESSING_TIMEOUT_MS) before uploads get 503. A worst
# case image takes ~150MB: raise the container's memory limit with the
# concurrency, and keep it below 4 (libuv's thread pool, shared with file and
# DNS work).
# IMAGE_PROCESSING_CONCURRENCY=2
# IMAGE_PROCESSING_QUEUE_LIMIT=10

# AWS S3 (if STORAGE_TYPE=s3)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=       # local RustFS: rustfsadmin
# AWS_SECRET_ACCESS_KEY=   # local RustFS: rustfsadmin123
# AWS_S3_BUCKET=
#
# S3-compatible storage (RustFS, MinIO, LocalStack, Cloudflare R2, DigitalOcean Spaces).
# Leave unset for real AWS S3. Setting an endpoint turns on path-style
# addressing automatically, which those servers require.
#
# AWS_S3_ENDPOINT        — where the APP reaches storage
# AWS_S3_PUBLIC_ENDPOINT — where BROWSERS reach it (avatar links); defaults to
#                          AWS_S3_ENDPOINT. Set it when the two differ.
#
# Local RustFS (`pnpm test:services:up`, which also creates AWS_S3_BUCKET;
# console http://localhost:9101/rustfs/console/, rustfsadmin / rustfsadmin123):
#   app in Docker (pnpm docker:dev):  AWS_S3_ENDPOINT=http://rustfs:9000
#                                     AWS_S3_PUBLIC_ENDPOINT=http://localhost:9100
#   app on the host (pnpm start:dev): AWS_S3_ENDPOINT=http://localhost:9100
# Port 9001 inside the container / 9101 on the host is RustFS's web console,
# not the S3 API.
# AWS_S3_ENDPOINT=http://localhost:9100
# AWS_S3_PUBLIC_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=true

# Logging
LOG_LEVEL=info  # debug | info | warn | error
# LOG_FORMAT=pretty   # json | pretty — unset: json in containers/production, pretty in a terminal

# Monitoring: where metrics, logs and alerts go.
#   local          Prometheus, Loki, Grafana and Alertmanager run beside the app
#   grafana-cloud  only Alloy runs here and sends everything to Grafana Cloud
#   off            development only: none of it (docs/docker.md, "Lighter ways to run")
# See docs/monitoring.md, "Grafana Cloud", for the switch and what it costs.
MONITORING=local

# With MONITORING=grafana-cloud: the stack's endpoints and a token that may
# write to them (your stack's Grafana → Connections → Data sources; and an
# access policy token with
# metrics:write and logs:write).
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USER=1234567
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-000.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=1234567
# GRAFANA_CLOUD_TOKEN=glc_...
# Only `pnpm monitoring:cloud-sync` uses these two: your stack's Grafana and a
# service account token (Admin) in it, to put the alert rules, the notification
# configuration and the dashboards there.
# GRAFANA_CLOUD_GRAFANA_URL=https://yourstack.grafana.net
# GRAFANA_CLOUD_GRAFANA_TOKEN=glsa_...

# Prometheus & Grafana (Monitoring)
PROMETHEUS_PORT=9090
# Not 3001: that is the web app's dev server.
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=admin

# Loki (Log Aggregation)
# Host port for Loki's API. The app does not talk to Loki: it logs to stdout
# and Alloy ships container output to Loki.
LOKI_PORT=3100
# Host port for the UI of Alloy (the log collector).
ALLOY_PORT=12345

# Alerts (Alertmanager; see docs/alerts.md)
# Where alerts are sent: a Discord webhook URL (Server Settings → Integrations →
# Webhooks). Slack and Teams webhooks work too, after changing the receiver in
# monitoring/alertmanager/alertmanager.yml. Required in production
# (https://discord.com/api/webhooks/<id>/<token>; docs/setup/discord-alerts.md).
# In development, leave it empty (alerts are shown in Alertmanager only) or set
# it to a test channel to receive development alerts.
ALERT_WEBHOOK_URL=
ALERTMANAGER_PORT=9093
# Optional: a heartbeat URL (e.g. https://hc-ping.com/<uuid>) that is called every
# minute while alerting works, so an outside service can tell you when it stops.
# Also uncomment the heartbeat receiver in monitoring/alertmanager/alertmanager.yml.
# ALERT_HEARTBEAT_URL=

# Error tracking (Sentry, or GlitchTip; see docs/error-tracking.md)
# The DSN of a Sentry project (Settings → Projects → <project> → Client Keys).
# Empty: error tracking is off and the app sends nothing anywhere.
SENTRY_DSN=
# Share of requests traced for performance (0 to 1). 0 keeps tracing off, which
# is what the free plan's quota is best spent on.
SENTRY_TRACES_SAMPLE_RATE=0
# The release each error belongs to. Leave it out: in production,
# docker-compose.prod.yaml sets it to the commit deploy.sh is deploying.
# SENTRY_RELEASE=

# Bull Board
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin

# ------------------------------------------------------------------------------
# Backups (the "backup" service in docker-compose.prod.yaml; see docs/backups.md)
# ------------------------------------------------------------------------------
# Each database is dumped on the schedule (UTC) to the backups volume, read back
# to check it, and old dumps are removed: the newest of each of the last
# BACKUP_KEEP_DAILY days and BACKUP_KEEP_WEEKLY weeks stay. deploy.sh also backs
# up before applying new migrations (kept apart: the last BACKUP_KEEP_LABELLED).
# BACKUP_SCHEDULE=0 3 * * *
# BACKUP_DATABASES=            # default: DB_NAME
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_LABELLED=5
#
# The server to dump: by default the db service, as DB_USERNAME. When the
# database moves to a managed Postgres, point these at it: the dumps then stay
# a copy that doesn't depend on that provider.
# BACKUP_DB_HOST=db
# BACKUP_DB_PORT=5432
# BACKUP_DB_USER=              # default DB_USERNAME
# BACKUP_DB_PASSWORD=          # default DB_PASSWORD
# BACKUP_DB_SSLMODE=prefer     # managed servers usually need: require
# BACKUP_MAINTENANCE_DB=postgres   # a database that always exists; DigitalOcean: defaultdb
# BACKUP_POSTGRES_IMAGE=postgres:16.2-alpine   # pg_dump must be >= the server's major version
#
# Copy every dump, and locally stored uploads, to an S3-compatible bucket at
# another provider (AWS S3, Cloudflare R2, Backblaze B2, RustFS). Strongly
# recommended: dumps on the server's disk are lost with the server.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=          # unset for AWS; R2: https://<account id>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=            # AWS: the bucket's region; R2: auto
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=            # folder in the bucket, e.g. myapp/
# BACKUP_S3_KEEP_DAYS=30       # delete uploaded dumps older than this; 0: never (use a key that can't delete, and a bucket lifecycle rule)

# ------------------------------------------------------------------------------
# Deploy (read by deploy.sh on the server; see docs/deploy.md)
# ------------------------------------------------------------------------------
# build: the server builds the image (default). registry: it pulls the image CI
# published for the commit, from DEPLOY_IMAGE (e.g. ghcr.io/you/your-app).
# DEPLOY_IMAGE_SOURCE=build
# DEPLOY_IMAGE=hexagonal-auth-prod-app
# DEPLOY_KEEP_IMAGES=3
# DEPLOY_HEALTH_TIMEOUT=600
