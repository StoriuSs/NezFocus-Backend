{
  "name": "testapp-backend-hexagonal-auth",
  "version": "1.0.0",
  "description": "A nest starter using hexagonal architecture",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "nest start --watch",
    "docker:dev": "docker compose --env-file .env.development -f docker-compose.dev.yaml up -d --build --remove-orphans",
    "docker:prod": "docker compose --env-file .env.production -f docker-compose.prod.yaml up -d --build --remove-orphans",
    "docker:down": "docker compose -f docker-compose.dev.yaml down",
    "docker:reset": "docker compose -f docker-compose.dev.yaml down -v",
    "docker:services": "docker compose --env-file .env.development -f docker-compose.dev.yaml --profile testing up -d --remove-orphans db redis rustfs rustfs-buckets mailpit && docker compose --env-file .env.development -f docker-compose.dev.yaml stop app",
    "docker:logs": "docker logs nestapp-nezfocus-web-dev -f --tail 200 | pino-pretty",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" \"k6/**/*.js\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" \"k6/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"k6/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"k6/**/*.js\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "cross-env NODE_ENV=production prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset",
    "prisma:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma --exit-code",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.js",
    "test:structure": "jest src/modules/module-structure.spec.ts",
    "prepare": "husky || true",
    "docker:down:prod": "docker compose -f docker-compose.prod.yaml down",
    "test:services:up": "docker compose --env-file .env.development -f docker-compose.dev.yaml --profile testing up -d db redis rustfs rustfs-buckets mailpit",
    "test:services:down": "docker compose -f docker-compose.dev.yaml --profile testing rm -sf rustfs rustfs-buckets",
    "test:integration": "node test/run-integration.cjs",
    "check:fast": "node scripts/constraints/lint-changed.mjs && node scripts/constraints/floor-guard.mjs && node scripts/constraints/secrets.mjs",
    "check:task": "pnpm check:fast && tsc --noEmit && pnpm test:structure && node scripts/constraints/coverage-changed.mjs",
    "check:full": "pnpm lint && pnpm format:check && tsc --noEmit && node scripts/constraints/floor-guard.mjs && node scripts/constraints/secrets.mjs && pnpm test && pnpm test:e2e && pnpm test:integration && pnpm openapi:check && pnpm env:check && pnpm audit --prod --audit-level high",
    "load:smoke": "k6 run k6/smoke.js",
    "load:test": "k6 run k6/load.js",
    "load:spike": "k6 run k6/spike.js",
    "load:upload": "k6 run k6/upload.js",
    "load:accounts": "ts-node -r tsconfig-paths/register --transpile-only src/bootstrap/load-accounts.ts",
    "openapi:export": "nest build -c nest-cli.openapi.json && node dist-openapi/src/bootstrap/export-openapi.js",
    "openapi:check": "nest build -c nest-cli.openapi.json && node dist-openapi/src/bootstrap/export-openapi.js --check",
    "env:check": "ts-node --transpile-only src/bootstrap/check-env.ts",
    "monitoring:cloud-sync": "ts-node --transpile-only src/bootstrap/monitoring-cloud-sync.ts",
    "sentry:check": "ts-node --transpile-only src/bootstrap/sentry-check.ts",
    "user:promote": "ts-node -r tsconfig-paths/register --transpile-only src/bootstrap/user-roles.ts",
    "monitoring:check": "docker run --rm -e COMPOSE_PROJECT=check -v ./monitoring/alloy:/etc/alloy:ro grafana/alloy:v1.19.2 validate /etc/alloy/local.alloy && docker run --rm -e COMPOSE_PROJECT=check -v ./monitoring/alloy:/etc/alloy:ro grafana/alloy:v1.19.2 validate /etc/alloy/grafana-cloud.alloy && docker run --rm -v ./monitoring/loki:/etc/loki:ro grafana/loki:3.7.7 -config.file=/etc/loki/loki-config.yml -verify-config && pnpm alerts:test",
    "alerts:test": "docker run --rm -v ./monitoring/prometheus:/etc/prometheus:ro --entrypoint sh prom/prometheus:v3.14.0 -c \"promtool check config /etc/prometheus/prometheus.yml && cd /etc/prometheus/tests && promtool test rules *.test.yml\" && docker run --rm -v ./monitoring/alertmanager:/etc/alertmanager:ro --entrypoint sh prom/alertmanager:v0.34.1 -c \"amtool check-config /etc/alertmanager/alertmanager.yml /etc/alertmanager/alertmanager.dev.yml && sh /etc/alertmanager/tests/routes.sh\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@aws-sdk/s3-request-presigner": "^3.943.0",
    "@bull-board/api": "^6.20.2",
    "@bull-board/express": "^6.20.2",
    "@bull-board/nestjs": "^6.20.2",
    "@keyv/redis": "^5.1.3",
    "@nestjs-modules/mailer": "2.3.10",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/platform-socket.io": "11.2.5",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "11.2.5",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nestjs": "^10.74.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "bullmq": "^5.70.1",
    "cache-manager": "^6.4.3",
    "cacheable": "^2.3.1",
    "camelcase-keys": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "17.4.2",
    "express-basic-auth": "^1.2.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.0.0",
    "joi": "^18.3.1",
    "jose": "^6.1.3",
    "js-yaml": "^5.4.2",
    "keyv": "^5.5.3",
    "multer": "^2.5.0",
    "nestjs-pino": "^5.1.0",
    "nodemailer": "^10.1.4",
    "openid-client": "^6.8.8",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "snakecase-keys": "^9.0.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "14.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.53.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
