          },
          "expr": "max(node_load1) / count(node_cpu_seconds_total{mode=\"idle\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Memory used",
