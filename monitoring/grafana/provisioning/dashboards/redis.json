    },
    {
      "id": 9,
      "type": "table",
      "title": "Jobs by queue and state",
      "description": "waiting: queued. active: being processed. delayed: scheduled for later, including retries waiting for their backoff and repeating jobs. failed: out of retries, kept 14 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "No queue data: the app is not running, or cannot reach Redis"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        },
        "sortBy": []
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "state",
            "rowField": "queue",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "queue\\state": 0,
              "waiting": 1,
              "active": 2,
              "delayed": 3,
              "failed": 4
            },
            "renameByName": {
              "queue\\state": "Queue"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (queue, state) (bullmq_jobs{state=~\"waiting|active|delayed|failed\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
