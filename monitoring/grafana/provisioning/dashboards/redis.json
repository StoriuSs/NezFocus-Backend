    {
      "id": 6,
      "type": "stat",
      "title": "Waiting jobs",
      "description": "Jobs queued in all BullMQ queues and not started yet. A number that keeps growing means workers are not keeping up, or not running.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "mappings": [],
          "noValue": "No queue data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (queue, state) (bullmq_jobs{state=~\"waiting|prioritized\"}))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Failed jobs",
      "description": "Jobs that used up all their retries, in all queues. They are kept 14 days for inspection in /admin/queues, then removed. Any new one is worth a look; the app also logs it (alert: AppErrorLogs).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
