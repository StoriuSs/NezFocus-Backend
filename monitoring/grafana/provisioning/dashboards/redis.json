    {
      "id": 16,
      "type": "timeseries",
      "title": "Fragmentation ratio",
      "description": "rss divided by used. With little data (under ~100 MB) it is naturally high and means nothing. With more, 1 to 1.5 is normal; far above means memory is held but unused (a restart releases it); below 1 means Redis is swapping.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
