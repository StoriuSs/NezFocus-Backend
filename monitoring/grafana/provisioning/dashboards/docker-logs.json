      "keepTime": true,
      "tags": [
        "stack"
      ],
      "targetBlank": false,
      "title": "Other dashboards",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Overview",
      "type": "row",
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Entries by service",
      "description": "How much each container logged in the selected range. A service suddenly logging far more than usual is worth a look.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "fieldMinMax": false
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 300
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\", service!~\"loki|alloy\"} [$__range]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Errors by service",
      "description": "Entries that look like errors. For the app, its error and fatal levels; for the others, lines containing error, fatal, panic or exception, except those marked level=info or level=debug. It still catches some harmless lines. The NestJS Logs dashboard is exact for the app.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "noValue": "No errors",
          "fieldMinMax": false
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 300
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\", service!~\"loki|alloy\", service!=\"app\"} |~ \"(?i)(\\\\berror\\\\b|\\\\bfatal\\\\b|\\\\bpanic\\\\b|exception)\" !~ \"(?i)\\\\blevel=(info|debug)\\\\b\" [$__range]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "instant"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\", service!~\"loki|alloy\", service=\"app\", level=~\"error|fatal\"} [$__range]))",
          "legendFormat": "{{service}}",
          "refId": "B",
          "queryType": "instant"
        }
      ]
    },
    {
      "collapsed": false,
