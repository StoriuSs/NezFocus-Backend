            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\", service!~\"loki|alloy\", service!=\"app\"} |~ \"(?i)(\\\\berror\\\\b|\\\\bfatal\\\\b|\\\\bpanic\\\\b|exception)\" !~ \"(?i)\\\\blevel=(info|debug)\\\\b\" [$__interval]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
