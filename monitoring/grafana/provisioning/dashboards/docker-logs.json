      },
      "id": 7,
      "title": "Log",
      "type": "row",
      "panels": []
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Log",
      "description": "Every container of this stack, newest first; the service name is in each line's details. Filter with Service and Search at the top; Search is a case-insensitive regular expression.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\", service!~\"loki|alloy\"} |~ \"(?i)$search\" | json | drop __error__, __error_details__ | line_format \"{{ .service }}  {{ if .msg }}{{ with .context }}[{{ . }}] {{ end }}{{ .msg }}{{ if .statusCode }}  {{ .method }} {{ .url }} → {{ .statusCode }} in {{ .duration }}ms{{ end }}{{ with .error_message }}  {{ . }}{{ end }}{{ with .err_message }}  {{ . }}{{ end }}{{ else }}{{ __line__ }}{{ end }}\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 1000
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "logs",
    "docker",
    "loki",
    "stack"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(service)",
        "regex": "/^(?!loki$|alloy$).+$/",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "options": []
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "value": "",
          "text": ""
        },
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Docker Logs",
  "uid": "docker-logs",
