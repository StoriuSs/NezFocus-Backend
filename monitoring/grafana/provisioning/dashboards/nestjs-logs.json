      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"app\"} !~ \"^\\\\{\" [$__range]))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
