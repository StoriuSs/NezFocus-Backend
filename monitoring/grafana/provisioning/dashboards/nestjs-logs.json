    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Entries by level",
      "description": "How much the app logs, per interval. Error and fatal in red; a column of them marks when something went wrong.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fatal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "debug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({service=\"app\", level=~\".+\"} [$__interval]))",
          "legendFormat": "{{level}}",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Errors by component",
      "description": "Which part of the app logged each error: HTTP and ExceptionsHandler (requests), RedisClient, QueueErrorLogger (BullMQ), a consumer, ... \"unstructured\" is a stack trace printed around the logger.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "label_replace(sum by (context) (count_over_time({service=\"app\", level=~\"error|fatal\"} | json context=\"context\" | __error__=\"\" [$__interval])), \"context\", \"(no context)\", \"context\", \"\")",
          "legendFormat": "{{context}}",
          "refId": "A",
          "queryType": "range"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"app\", level=~\"error|fatal\"} !~ \"^\\\\{\" [$__interval]))",
          "legendFormat": "unstructured",
          "refId": "B",
          "queryType": "range"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 11,
      "title": "What went wrong",
      "type": "row",
      "panels": []
    },
    {
      "id": 12,
      "type": "table",
      "title": "Most frequent errors",
      "description": "Error and fatal messages in the selected range, by component, most frequent first. Search for one in the log below to see its details.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Component"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        },
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "context": 0,
              "msg": 1,
              "Value #A": 2
            },
            "renameByName": {
              "context": "Component",
              "msg": "Message",
              "Value #A": "Count"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (context, msg) (count_over_time({service=\"app\", level=~\"error|fatal\"} | json context=\"context\", msg=\"msg\" | __error__=\"\" [$__range])))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Failed requests",
      "description": "4xx and 5xx responses in the selected range, by route and status. The URL is as requested, ids included.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Method"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        },
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "statusCode": 0,
              "method": 1,
              "url": 2,
              "Value #A": 3
            },
            "renameByName": {
              "statusCode": "Status",
              "method": "Method",
              "url": "URL",
              "Value #A": "Count"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (method, url, statusCode) (count_over_time({service=\"app\"} |= \"statusCode\" | json statusCode=\"statusCode\" | __error__=\"\" | statusCode >= 400 | json method=\"method\", url=\"url\" [$__range])))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 14,
      "title": "Log",
      "type": "row",
      "panels": []
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Log",
      "description": "One line per entry, newest first: [component] message, and for requests the method, URL, status and duration. Click a line for every field (requestId, error, stack). Filter with Level and Search at the top; Search is a case-insensitive regular expression.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"app\", level=~\"$level\"} |~ \"(?i)$search\" | json | drop __error__, __error_details__ | line_format \"{{ if .msg }}{{ with .context }}[{{ . }}] {{ end }}{{ .msg }}{{ if .statusCode }}  {{ .method }} {{ .url }} → {{ .statusCode }} in {{ .duration }}ms{{ end }}{{ with .error_message }}  {{ . }}{{ end }}{{ with .err_message }}  {{ . }}{{ end }}{{ else }}{{ __line__ }}{{ end }}\"",
          "refId": "A",
          "queryType": "range",
          "maxLines": 1000
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "logs",
    "nestjs",
    "loki",
    "stack"
  ],
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,fatal,warn,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "value": "",
          "text": ""
        },
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "NestJS Logs",
  "uid": "nestjs-logs",
  "version": 1,
  "weekStart": ""
